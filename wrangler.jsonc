{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "approval-notification-sample",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-05-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // /api/* は静的アセットより先に Worker で処理する
    "run_worker_first": ["/api/*"]
  },
  // 送信に失敗した通知メールを定期的に再送する
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // メール内リンクのベース URL。本番では Cloudflare のダッシュボードなどで上書きする
    "APP_URL": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "approval-sample",
      // `wrangler d1 create approval-sample` で表示された ID に置き換える（秘密情報ではない）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
